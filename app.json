{
  "expo": {
    "name": "Doamar",
    "slug": "DoamarApp",
    "version": "1.0.0",
    "web": {
      "favicon": "./src/assets/global/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o $(PRODUCT_NAME) use sua localização para encontrar instituições próximas."
        }
      ]
    ],
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./src/assets/global/doamarIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/global/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#39503B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/global/doamarIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.uluketa.DoamarApp"
    },
    "extra": {
      "eas": {
        "projectId": "389601e2-1ae9-422b-be86-60cb56b2cdff"
      }
    }
  }
}
